{
  "name": "ribachenko.com-svelte",
  "version": "0.0.1",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "puppeteer",
      "sharp",
      "svelte-preprocess"
    ]
  },
  "scripts": {
    "get:map": "node --experimental-specifier-resolution=node --loader ts-node/esm src/build/map.ts",
    "get:pdf": "node --experimental-specifier-resolution=node --loader ts-node/esm src/build/pdf.ts",
    "build-config": "rm -f config.ts && buildconfig --input config.json --output src/config.ts --env $CONFIG_ENV --module-type typescript",
    "build-config:local": "CONFIG_ENV=local pnpm run build-config",
    "build-config:prod": "CONFIG_ENV=prod pnpm run build-config",
    "start": "source ~/.nvm/nvm.sh && nvm use && pnpm run build-config:local && pnpm run dev",
    "dev": "vite dev --port 4000",
    "build": "pnpm run build-config:prod && pnpm run get:map && vite build && node src/build/pdf-static.mjs",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check ./src && eslint . && stylelint 'src/**/*.{css,scss,svelte}'",
    "format": "prettier --write ./src"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@poppanator/sveltekit-svg": "^7.0.1",
    "@sveltejs/adapter-netlify": "^6.0.4",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/lodash-es": "^4.17.12",
    "@types/prismjs": "^1.26.6",
    "@typescript-eslint/eslint-plugin": "8.55.0",
    "@typescript-eslint/parser": "8.55.0",
    "autoprefixer": "^10.5.4",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^16.5.0",
    "node-fetch": "^3.3.2",
    "postcss": "^8.5.26",
    "postcss-custom-media": "^12.0.1",
    "postcss-html": "^2.0.0",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "puppeteer": "^25.9.0",
    "sharp": "^0.35.4",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-scss": "^7.2.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "svelte-preprocess": "^6.0.5",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "type": "module",
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.23",
    "front-matter": "^4.0.2",
    "lodash-es": "^4.18.1",
    "marked": "^18.0.11",
    "node-html-parser": "^9.0.2",
    "prismjs": "^1.30.0",
    "sass": "^1.103.1",
    "single-config": "^2.0.1",
    "xss": "^1.0.15"
  }
}
